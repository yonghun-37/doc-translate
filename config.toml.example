# 운영: 사내 LLM 주소와 모델명을 입력한 뒤 config.toml로 복사합니다.
# 이미 사용하는 config.toml을 덮어쓰지 마세요.
[translator]
engine = "openai_compatible"

[translator.openai_compatible]
base_url = "https://llm.example.internal/v1"
model = "TODO-model-name"
api_key_env = "DOC_TRANSLATE_API_KEY"
api_key_file = ""
allowed_hosts = ["llm.example.internal"]
ca_bundle = ""
trust_env_proxy = false
temperature = 0
# JSON 배열 출력과 json_object 강제가 충돌할 수 있으므로 기본 비활성입니다.
json_mode = false
max_tokens = 4096
timeout_sec = 180
retry = 3
concurrent = 4
# 진행 상황을 알리는 고유 새 문장 묶음 크기. 묶음 내부 병렬 처리는 docutranslate가 담당합니다.
progress_batch = 40
extra_body = {}

# 미리보기만 제어합니다. 실제 번역 출력 생성에는 영향을 주지 않습니다.
[render]
# 환경변수 DOC_TRANSLATE_SOFFICE가 우선. 빈 값이면 PATH, /opt/libreoffice*/program/soffice 탐색.
soffice = ""
timeout_sec = 120
max_pages = 300
