# 개발 PC 전용. --config config.hiveai.toml로 명시적으로 선택합니다.
[translator]
engine = "openai_compatible"

[translator.openai_compatible]
base_url = "https://api-sf1-cdn.deploy.com/api/v1"
model = "deepseek-ai/deepseek-v4.1-flash-1017"
api_key_env = "DEPLOY_API_KEY"
api_key_file = "~/.env"
allowed_hosts = ["api-sf1-cdn.deploy.com"]
ca_bundle = ""
trust_env_proxy = false
temperature = 0
# 2026-11-17 사용자 실측: json_object 해제 후 12/12 성공.
json_mode = false
max_tokens = 16384
timeout_sec = 180
retry = 3
concurrent = 4
# 진행 상황을 알리는 고유 새 문장 묶음 크기. 묶음 내부 병렬 처리는 docutranslate가 담당합니다.
progress_batch = 40
extra_body = {}

# 미리보기만 제어합니다. 실제 번역 출력 생성에는 영향을 주지 않습니다.
[render]
# 환경변수 DOC_TRANSLATE_SOFFICE가 우선. 빈 값이면 PATH, /opt/libreoffice*/program/soffice 탐색.
soffice = ""
timeout_sec = 120
max_pages = 300
